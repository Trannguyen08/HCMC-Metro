# ============================================================================
# HCMC Metro - Environment Variables Example
# Copy this file to .env and fill in with your actual values
# DO NOT commit .env to git - only .env.example should be committed
# ============================================================================

# ============================================================================
# BACKEND (Django)
# ============================================================================

### Core Django Settings
SECRET_KEY=your-super-secret-key-change-this-in-production
DEBUG=True
BACKEND_URL=http://backend:8000

### Database Configuration
DATABASE_URL=postgres://postgres:postgres@db:5432/postgres
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=db
DB_PORT=5432

### Django Admin / pgAdmin
ALLOWED_HOSTS=*
CORS_ALLOWED_ORIGINS=http://127.0.0.1:3000,http://localhost:3000,http://localhost:8080,http://127.0.0.1:8080

### pgAdmin Access (for database management)
PGADMIN_DEFAULT_EMAIL=admin@admin.com
PGADMIN_DEFAULT_PASSWORD=admin

### Google OAuth Authentication
GOOGLE_CLIENT_ID=your-google-client-id-here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret-here

### Email Configuration (Gmail SMTP)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password-here
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
DEFAULT_FROM_EMAIL=HCMC Metro <noreply@metrohcm.vn>

### Cache & Session (Redis)
REDIS_URL=redis://redis:6379/0

### Message Queue (RabbitMQ for Celery)
CELERY_BROKER_URL=amqp://guest:guest@rabbitmq:5672//
CELERY_RESULT_BACKEND=redis://redis:6379/0
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672

### Payment Gateway (PayOS)
PAYOS_CLIENT_ID=your-payos-client-id
PAYOS_API_KEY=your-payos-api-key
PAYOS_CHECKSUM_KEY=your-payos-checksum-key
PAYOS_API_BASE=https://api-merchant.payos.vn

### AI Chatbot (Groq API)
GROQ_API_KEY=your-groq-api-key-here
GROQ_MODEL=llama-3.3-70b-versatile
MAX_TOKENS=800

# ============================================================================
# FRONTEND (Next.js)
# ============================================================================

### API & Authentication
NEXT_PUBLIC_API_URL=http://localhost:8000/api
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-client-id-here.apps.googleusercontent.com

### Admin Account Credentials
# NOTE: An admin account is automatically created in the database when you run the SQL schema
# with these credentials. Change the password in production!
ADMIN_EMAIL=admin@metrohcm.vn
ADMIN_PASSWORD=admin123

### Media Storage (Cloudinary)
CLOUD_API_KEY=your-cloudinary-api-key
CLOUD_SECRET_KEY=your-cloudinary-secret-key
CLOUD_URL=cloudinary://your-api-key:your-secret-key@your-cloud-name

# ============================================================================
# UI Documentation (Read-only - used in Swagger)
# ============================================================================
SWAGGER=http://localhost:8080/api/schema/swagger-ui/
REDOC=http://localhost:8080/api/schema/redoc/
